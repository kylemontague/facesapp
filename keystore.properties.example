# ==============================================================================
# Faces Release Signing Configuration Example
# ==============================================================================
# Copy this file to 'keystore.properties' in the repository root and fill in your
# actual keystore details. 'keystore.properties' is ignored by git.
#
# Alternatively, you can supply these via environment variables in CI/CD:
# - KEYSTORE_FILE
# - KEYSTORE_PASSWORD
# - KEY_ALIAS
# - KEY_PASSWORD
# ==============================================================================

storeFile=faces-release.jks
storePassword=your_keystore_password_here
keyAlias=faces_key_alias_here
keyPassword=your_key_password_here
