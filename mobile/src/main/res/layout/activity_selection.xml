<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:background="@color/black"
    android:padding="0dp">


    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:id="@+id/top_info_overlay"/>

    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/info_overlay"/>


    <android.support.v4.view.ViewPager
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/watch_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_info_overlay"
        android:layout_alignParentStart="true" />


    <View
        android:layout_width="fill_parent"
        android:layout_height="100dp"
        android:background="@drawable/top_gradient"/>
    <View
        android:layout_width="fill_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bottom_gradient"/>
    <Button
        style="@style/Base.Widget.AppCompat.Button.Borderless.Colored"
        android:textColor="@color/white"
        android:textAllCaps="true"
        android:textSize="16sp"
        android:id="@+id/AmbientMode"
        android:text="@string/text_active_mode"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="20dp"
        android:layout_centerHorizontal="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageButton
        android:layout_alignParentStart="true"
        android:layout_marginStart="40dp"
        android:layout_marginTop="90dp"
        android:tint="@color/white"
        android:background="@null"
        android:src="@drawable/ic_delete"
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageButton
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="90dp"
        android:tint="@color/white"
        android:background="@null"
        android:src="@drawable/ic_favorite_border"
        android:id="@+id/favouriteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />




    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true">

        <Button
            android:id="@+id/TakePhoto"
            android:text="@string/button_select_face"
            android:layout_width="@dimen/button_width"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/button_transparent"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:textSize="@dimen/button_fontsize"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>
        <Button
            android:visibility="gone"
            android:id="@+id/settings"
            android:text="@string/button_face_settings"
            android:layout_marginStart="10dp"
            android:layout_width="@dimen/button_width"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/button_transparent"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:textSize="@dimen/button_fontsize"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

    <ImageButton
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="35dp"
        android:tint="@color/white"
        android:background="@null"
        android:src="@drawable/ic_today_black_24dp"
        android:id="@+id/todayButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</RelativeLayout>
